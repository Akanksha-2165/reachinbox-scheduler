# ==============================================================================
# Environment Configuration (.env.example)
# Note: Zero hardcoded values in codebase. All configurations are read from env.
# ==============================================================================

# Server configuration
PORT=3000

# Database (MySQL via Docker exposed on port 3307)
DATABASE_URL="mysql://root:root@localhost:3307/scheduler"

# Redis (BullMQ queue broker on port 6379)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# BullMQ Queue & Worker configuration
QUEUE_NAME="email-queue"
WORKER_CONCURRENCY=5
# Minimum delay between sends enforced queue-wide via BullMQ worker limiter (ms)
MIN_DELAY_BETWEEN_SENDS_MS=1000

# Rate Limiting & Scheduling Defaults
DEFAULT_DELAY_BETWEEN_MS=0
DEFAULT_HOURLY_LIMIT=100
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# Nodemailer / Ethereal: Disable in-memory caching so seed creates multiple unique accounts
ETHEREAL_CACHE="false"

